# Gateyes runtime
GATEYES_CONFIG_PATH=configs/config.example.yaml
GATEYES_DATABASE_DSN=host=localhost port=5432 user=gateyes password=change-me-db-password dbname=gateyes sslmode=disable

# Bootstrap API keys
GATEYES_BOOTSTRAP_TEST_KEY=demo-key-001
GATEYES_BOOTSTRAP_TEST_SECRET=change-me-demo-secret
GATEYES_ADMIN_BOOTSTRAP_KEY=admin-key-001
GATEYES_ADMIN_BOOTSTRAP_SECRET=change-me-admin-secret

# Providers used by configs/config.example.yaml
LONGCAT_API_KEY=change-me-longcat-key
LONGCAT_ALT_API_KEY=change-me-longcat-alt-key
BIGMODEL_API_KEY=change-me-bigmodel-key
DEEPSEEK_API_KEY=change-me-deepseek-key

# Optional OpenAI/Anthropic provider defaults for custom configs
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=change-me-openai-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=change-me-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Tracing
OTLP_ENDPOINT=

# Alerts
GATEYES_ALERT_WEBHOOKURL=
GATEYES_ALERT_WEBHOOKSECRET=

# Feishu (Lark) alert integration
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# Active configs/config.yaml provider/API-key placeholders
CODEXAPIS_API_KEY=change-me-codexapis-key
GATEYES_DEMO_SECRET=change-me-demo-secret
GATEYES_CHAT_SECRET=change-me-chat-secret
GATEYES_SESSION_SECRET=change-me-session-secret
GATEYES_AGENT_SECRET=change-me-agent-secret
GATEYES_EMBED_SECRET=change-me-embed-secret
GATEYES_BAD_SECRET=change-me-bad-secret
GATEYES_SPIKE_SECRET=change-me-spike-secret
