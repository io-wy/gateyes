{
  "id": null,
  "uid": "gateyes-cache",
  "title": "Gateyes Cache & Provider Metrics",
  "tags": [
    "gateyes",
    "cache",
    "provider",
    "vllm"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "provider",
        "type": "query",
        "query": "label_values(gateway_llm_tokens_total, provider)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Gateway L1 Cache Hit Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(gateway_cache_lookups_total{result=\"hit\"}[1m]) / rate(gateway_cache_lookups_total[1m])",
          "legendFormat": "L1 hit rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 18,
      "title": "Current L1 Cache Hit Rate",
      "type": "bargauge",
      "targets": [
        {
          "expr": "rate(gateway_cache_lookups_total{result=\"hit\"}[5m]) / rate(gateway_cache_lookups_total[5m])",
          "legendFormat": "L1 hit rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Upstream Prompt Cache Ratio",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(gateway_llm_tokens_total{token_type=\"cached\"}[1m]) / ignoring(token_type) rate(gateway_llm_tokens_total{token_type=\"prompt\"}[1m])",
          "legendFormat": "cached / prompt",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 19,
      "title": "Current Upstream Prompt Cache Ratio",
      "type": "bargauge",
      "targets": [
        {
          "expr": "rate(gateway_llm_tokens_total{token_type=\"cached\"}[5m]) / ignoring(token_type) rate(gateway_llm_tokens_total{token_type=\"prompt\"}[5m])",
          "legendFormat": "cached / prompt",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 3,
      "title": "Cache Lookups (hit/miss/error)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(gateway_cache_lookups_total[1m])",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 4,
      "title": "LLM Tokens by Type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(gateway_llm_tokens_total[1m])",
          "legendFormat": "{{provider}} - {{token_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "id": 5,
      "title": "Prompt Cache Ratio Distribution",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(gateway_llm_prompt_cache_ratio_bucket[1m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(gateway_llm_prompt_cache_ratio_bucket[1m]))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 17,
      "title": "Prompt Cache Ratio Heatmap",
      "type": "heatmap",
      "targets": [
        {
          "expr": "sum by (le) (rate(gateway_llm_prompt_cache_ratio_bucket[1m]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "dataFormat": "tsbuckets",
      "yAxis": {
        "unit": "percentunit",
        "logBase": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "id": 6,
      "title": "Request Latency P95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(gateway_llm_request_duration_seconds_bucket[1m]))",
          "legendFormat": "{{provider}} - {{surface}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 7,
      "title": "Upstream Latency P95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(gateway_llm_upstream_duration_seconds_bucket[1m]))",
          "legendFormat": "{{provider}} - {{surface}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      }
    },
    {
      "id": 8,
      "title": "Requests Total by Provider/Result",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(gateway_llm_requests_total[1m])",
          "legendFormat": "{{provider}} - {{surface}} - {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      }
    },
    {
      "id": 9,
      "title": "Provider Current Load",
      "type": "timeseries",
      "targets": [
        {
          "expr": "gateway_provider_current_load{provider=~\"$provider\"}",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      }
    },
    {
      "id": 10,
      "title": "Provider TPM",
      "type": "timeseries",
      "targets": [
        {
          "expr": "gateway_provider_tpm{provider=~\"$provider\"}",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tpm",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
