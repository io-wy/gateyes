      "type": "timeseries",
      "targets": [
        {
          "expr": "gateway_provider_gpu_cache_usage_ratio{provider=~\"$provider\"}",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      }
    },
    {
      "id": 12,
      "title": "vLLM Prefix Cache Hit Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "gateway_provider_prefix_cache_hit_rate_ratio{provider=~\"$provider\"}",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      }
    },
    {
      "id": 13,
      "title": "vLLM Prefix Cache Queries / Hits",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(gateway_provider_prefix_cache_queries{provider=~\"$provider\"}[1m])",
          "legendFormat": "queries - {{provider}}",
          "refId": "A"
        },
        {
          "expr": "rate(gateway_provider_prefix_cache_hits{provider=~\"$provider\"}[1m])",
          "legendFormat": "hits - {{provider}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      }
    },
    {
      "id": 14,
      "title": "Errors / Retries / Fallbacks",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(gateway_llm_errors_total[1m])",
          "legendFormat": "errors - {{surface}} - {{error_class}}",
          "refId": "A"
        },
        {
          "expr": "rate(gateway_llm_retries_total[1m])",
          "legendFormat": "retries - {{provider}}",
          "refId": "B"
        },
        {
          "expr": "rate(gateway_llm_fallbacks_total[1m])",
          "legendFormat": "fallbacks - {{provider}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
