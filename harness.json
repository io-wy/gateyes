{
  "module": "github.com/gateyes/gateway",
  "layers": [
    {"pattern": "internal/app/config", "layer": 0, "name": "config"},
    {"pattern": "internal/pkg", "layer": 1, "name": "shared"},
    {"pattern": "pkg/plugin", "layer": 1, "name": "public-plugin-contracts"},
    {"pattern": "internal/domain", "layer": 2, "name": "domain"},
    {"pattern": "internal/repository", "layer": 3, "name": "repository"},
    {"pattern": "internal/service", "layer": 4, "name": "service"},
    {"pattern": "internal/ports", "layer": 4, "name": "application-ports"},
    {"pattern": "internal/application", "layer": 5, "name": "application"},
    {"pattern": "internal/handler", "layer": 6, "name": "http-transport"},
    {"pattern": "internal/transport", "layer": 6, "name": "http-transport"},
    {"pattern": "internal/app/gateway", "layer": 7, "name": "composition-root"},
    {"pattern": "internal/testutil", "layer": 8, "name": "testutil"},
    {"pattern": "cmd", "layer": 8, "name": "cmd"}
  ],
  "ignoreDirs": ["vendor", "third_party", "tmp", "scripts", ".claude", ".codegraph", "plugins"],
  "allowCyclic": []
}
