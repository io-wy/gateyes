{
  "module": "github.com/gateyes/gateway",
  "layers": [
    {"pattern": "pkg/plugin", "layer": 0, "name": "public-plugin-contracts"},
    {"pattern": "internal/pkg/eventbus", "layer": 0, "name": "shared-eventbus"},
    {"pattern": "internal/pkg/gateerror", "layer": 0, "name": "shared-errors"},
    {"pattern": "internal/pkg/logging", "layer": 0, "name": "shared-logging"},
    {"pattern": "internal/pkg/redis", "layer": 0, "name": "shared-redis"},
    {"pattern": "internal/pkg/trace", "layer": 0, "name": "shared-trace"},
    {"pattern": "internal/domain", "layer": 1, "name": "domain"},
    {"pattern": "internal/app", "layer": 2, "name": "app-config"},
    {"pattern": "internal/repository", "layer": 3, "name": "repository"},
    {"pattern": "internal/service", "layer": 4, "name": "service"},
    {"pattern": "internal/handler", "layer": 5, "name": "handler"},
    {"pattern": "internal/testutil", "layer": 6, "name": "testutil"},
    {"pattern": "cmd", "layer": 6, "name": "cmd"}
  ],
  "ignoreDirs": ["vendor", "third_party", "tmp", "scripts", ".claude", ".codegraph", "plugins"],
  "allowCyclic": []
}
